    {
      "pattern": "\\b[\\w.+-]+@[\\w-]+\\.[\\w.-]{2,}\\b",
      "label": "email",
      "priority": 9
    },
    {
      "pattern": "\\b(?:\\+?\\d{1,3}[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b",
      "label": "phone",
      "priority": 5
    },
    {
      "pattern": "https?://[\\w./\\-_?=%&#@+~]+",
      "label": "url",
      "priority": 3
